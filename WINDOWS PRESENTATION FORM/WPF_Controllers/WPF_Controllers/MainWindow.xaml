<Window x:Class="WPF_Controllers.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="850" Icon="/person.png">
    <Grid>
        <StackPanel Margin="5,-200,-5,0">
            <Label Content="check box controller"/>
            <CheckBox Name="checkbox1" Content="two Stats" Height="50" Width="150" HorizontalAlignment="Left" Margin="3,230,0,154" Checked="Handlchecked" Unchecked="Handlunchecked"/>
            <CheckBox Name="checkbox2" Content="Three stats" Height="50" Width="150"  HorizontalAlignment="Left" Margin="8,-100,80,100" Checked="Handlchecked"  Unchecked="Handlunchecked"/>
            <TextBox x:Name="txt1" HorizontalAlignment="Left" Margin="158,-260,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="200" Height="36"/>
            <TextBox Name="txt2" HorizontalAlignment="Left" Margin="158,-160,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="200" Height="36"/>
        </StackPanel>

        <StackPanel>
            <Label Content="Context Menu :" Margin="250,5" HorizontalAlignment="Right" Width="150" />
            <TextBox x:Name="txtBox" Text="This is context menu text" HorizontalAlignment="Right" Width="400" Height="100" Margin="10">
                <TextBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="IsBold" Checked="BoldeChecked" Unchecked="BoldUnChecked" IsCheckable="True"/>
                        <MenuItem Header="Italic" Checked="italicChecked" Unchecked="itlalicUncheck" IsCheckable="True"/>
                        <Separator/>
                        <MenuItem Header="Font_Increse" Click="Font_Increase"/>
                        <MenuItem Header="Font_Decrease" Click="Font_Decrease"/>
                        <MenuItem Header="copy" Click="Copy"/>
                        <MenuItem Header="past" Click="Past"/>
                        <MenuItem Header="Cut" Click="Cut"/>
                        <MenuItem Header="Undo" Click="Undo" />
                        <MenuItem/>
                    </ContextMenu>
                </TextBox.ContextMenu>
            </TextBox>
        </StackPanel>

        <StackPanel >
            <Label Content="Dialog Box :" Margin="5,250" Width="150" HorizontalAlignment="Left" FontFamily="Arial Black"/>
            <Button Height="50" Width="120" Margin="-450,-290,100,150" FontFamily="Bahnschrift" FontSize="14" Name="ShowmsgBox" Click="MsgBox">
                show massege
            </Button>

            <TextBox Height="50" Width="150" Name="txtBox2" HorizontalAlignment="Left" Margin="50,-180,100,150" SelectionBrush="#FF2E4454"/>
        </StackPanel>

        <StackPanel HorizontalAlignment="Right" Margin="0,199,36,52">
            <Label Content="Menu Controller :"/>
            <Menu Height="50" Width="350" Margin="15">
                <MenuItem Header="File" Height="50" Width="116.6">
                    <MenuItem Header="Item1" Click="MenuItem1"/>
                    <MenuItem Header="item2" Click="MenuItem2"/>
                    <MenuItem Header="item3" Click="MenuItem3"/>
                </MenuItem>

                <MenuItem Header="Edit" Height="50" Width="116.67">
                    <MenuItem Header="item1" Click="MenuItem1"/>
                    <MenuItem Header="item2" Click="MenuItem2"/>
                    <MenuItem Header="item3" Click="MenuItem3"/>
                </MenuItem>
                <MenuItem Header="View" Height="50" Width="116.67">
                    <MenuItem Header="item1" Click="MenuItem1"/>
                    <MenuItem Header="item2" Click="MenuItem2"/>
                    <MenuItem Header="item3" Click="MenuItem3"/>
                </MenuItem>
            </Menu>
        </StackPanel>


        <StackPanel Height="50" Margin="350,364,10,20">
            <Border BorderThickness="5" BorderBrush="Gray" Height="50">
                <StackPanel>
                    <TextBlock Text="Value Based Progress bar"/>
                    <ProgressBar Value="100" Maximum="250" Height="15" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
