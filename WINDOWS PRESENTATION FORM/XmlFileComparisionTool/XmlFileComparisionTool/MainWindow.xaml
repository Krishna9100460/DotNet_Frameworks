<Window x:Class="XmlFileComparisionTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:XmlFileComparisionTool"
        mc:Ignorable="d"
        Title="XML COMPARISON TOOL" Height="450" Width="800" Icon="/compare_header.jpg">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="159*"/>
        </Grid.ColumnDefinitions>


        <Button Content="Compare" Command="{Binding CompareFile}" HorizontalAlignment="Left" Margin="542,50,0,0" VerticalAlignment="Top" Height="50" Width="150" FontFamily="Arial Black" Grid.Column="1"  />
        <Label Content="Upload Golden File :" HorizontalAlignment="Left" Margin="53,8,0,0" VerticalAlignment="Top" FontFamily="Arial Black" Width="150" Grid.Column="1" Height="24"/>
        <Label Content="Compare Both Files :" HorizontalAlignment="Left" Margin="542,6,0,0" VerticalAlignment="Top" FontFamily="Arial Black" Width="150" Grid.Column="1" Height="24"/>
        <Label Content="Upload Current File : " HorizontalAlignment="Left" Margin="294,8,0,0" VerticalAlignment="Top" FontFamily="Arial Black" Width="150" Grid.Column="1" Height="24"/>
        <Button Content="Golden Report" Command="{Binding UploadFile2Command}" HorizontalAlignment="Left" Margin="53,50,0,0" VerticalAlignment="Top" Height="50" Width="150" FontFamily="Arial Black" Grid.Column="1" />
        <Button Content="Current Report"  Command="{Binding UploadFile1Command }" HorizontalAlignment="Left" Margin="294,50,0,0" VerticalAlignment="Top" Height="50" Width="150" FontFamily="Arial Black" Grid.Column="1" />

    </Grid>
</Window>
