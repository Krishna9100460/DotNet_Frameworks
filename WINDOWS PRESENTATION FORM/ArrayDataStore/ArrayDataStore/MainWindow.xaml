<Window x:Class="ArrayDataStore.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ArrayDataStore"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Button Content="Add" HorizontalAlignment="Left" Margin="371,345,0,0" VerticalAlignment="Top" Width="136" Height="58" Click="Button_Click" Background="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" FontFamily="Arial Black" FontSize="16"/>
        <TextBox x:Name="txtllenbth" HorizontalAlignment="Left" Margin="281,25,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="267" Height="36"/>
        <Label x:Name="Lbl" Content="Enter Array Length" HorizontalAlignment="Left" Margin="26,25,0,0" VerticalAlignment="Top" Height="36" Width="229"/>
        <Label x:Name="lblData" Content="Data" HorizontalAlignment="Left" Margin="157,113,0,0" VerticalAlignment="Top" Height="205" Width="539"/>
        <TextBox x:Name="txtName" HorizontalAlignment="Left" Margin="281,72,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="267" Height="36"/>
        <Label x:Name="Lbl_Copy" Content="Enter Names" HorizontalAlignment="Left" Margin="26,72,0,0" VerticalAlignment="Top" Height="36" Width="229"/>
        <Button x:Name="ShowBtn" Content="Show" HorizontalAlignment="Left" Margin="189,334,0,0" VerticalAlignment="Top" Height="58" Width="137" Click="ShowBtn_Click" RenderTransformOrigin="0.5,0.5" FontFamily="Arial Black" FontSize="18">
            <Button.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform X="2" Y="10"/>
                </TransformGroup>
            </Button.RenderTransform>
        </Button>

    </Grid>
</Window>
