<Application x:Class="CalculatorApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CalculatorApp"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="numberBtn" Color="CadetBlue" Opacity="20"/>
        <SolidColorBrush x:Key="OperatorBtn" Color="BurlyWood"/>
        
        <!--#region This style for the Number Button region-->
        <Style TargetType="Button" x:Key="numberBtnStyle">
            <Setter Property="FontWeight" Value="ExtraBlack"/>
            <Setter Property="Margin" Value="2,2,2,2"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Background" Value="{StaticResource numberBtn}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers> 
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!--#endregion-->
        
        <!--#region this style for the operator buttton-->
        <Style TargetType="Button" x:Key="OperatorBtnStyle" BasedOn="{StaticResource numberBtnStyle}">
            <Setter Property="Background" Value="{StaticResource OperatorBtn}"/>
        </Style>
        <!--#endregion-->
    </Application.Resources>
</Application>
