<Window x:Class="INotiFyPropertyChanged.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:INotiFyPropertyChanged"
        xmlns:model="clr-namespace:INotiFyPropertyChanged.Model"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <model:Person x:Key="m"></model:Person>
    </Window.Resources>
    <Grid >

        <StackPanel>
            <TextBlock Text="Register/Login"/>
            <StackPanel>
                <TextBlock Text="UserName :" Height="30" Width="150" Margin="55,5,400,-30" FontSize="20" FontFamily="Arial Black"/>
                <TextBox x:Name="txtUserName" Width="200" Height="35" FontFamily="Arial Black" FontSize="14" TextAlignment="Center"/>
                <TextBlock Text="Password  :" Height="30" Width="150" Margin="55,5,400,-45" FontSize="20" FontFamily="Arial Black"/>
                <TextBox x:Name="txtPass"  Width="200" Height="35" FontFamily="Arial Black" FontSize="14" Margin="5" TextAlignment="Center"/>
            </StackPanel>

            <StackPanel>
                <Button x:Name="Register" Content="Register" Height="40" Width="150" HorizontalAlignment="Left" Margin="100,0,0,0" FontFamily="Arial Black" FontSize="14" BorderBrush="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" Click="Register_Click"/>
                <Button x:Name="Login" Content="Login" Height="40" Width="150" Margin="5,-40,-450,5" FontFamily="Arial Black" FontSize="14" Background="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" Click="Login_Click"/>
            </StackPanel>
        </StackPanel>

        



    </Grid>
</Window>
