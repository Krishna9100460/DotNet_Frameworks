<Window x:Class="ContactApp.ContactWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ContactApp"
        mc:Ignorable="d"
        Title="New contact" Height="450" Width="500" Icon="/newcontact.jpg">
    <StackPanel Margin="5">
        <Label Content="First Name :" FontSize="15" FontStyle="Italic" FontWeight="Bold"/>
        <TextBox x:Name="firstNameTxt" Width="210" Margin="0,0,265,0" ToolTip="Your Name"/>
        <Label Content="Last Name :" FontStyle="Italic" FontSize="15" FontWeight="Bold" Margin="260,-50,0,0"/>
        <TextBox x:Name="lastNameTxt" Width="210" Margin="260,-20,0,0" ToolTip="Surname" />
        <Label Content="Email :" FontStyle="Italic" FontSize="15" FontWeight="Bold"/>
        <TextBox x:Name="EmialTxt" Width="470"/>
        <Label Content="Phone Number :" FontStyle="Italic" FontSize="15" FontWeight="Bold"/>
        <TextBox x:Name="numberTxt" Width="470" />
        <Button Content="Save" Click="Save_Clicked" Margin="10" Style="{DynamicResource NewContact}"/>
    </StackPanel>
</Window>
