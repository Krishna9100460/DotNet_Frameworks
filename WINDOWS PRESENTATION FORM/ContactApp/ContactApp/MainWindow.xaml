<Window x:Class="ContactApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:uc="clr-namespace:ContactApp.Controllers"
        xmlns:local="clr-namespace:ContactApp"
        mc:Ignorable="d"
        Title="Contact" Height="600" Width="800" Icon="/ContactIcon.jpg" WindowStartupLocation="CenterScreen">
    <StackPanel Margin="5">
        <Button Content="New contact" Click="NewContact_clicked" Style="{DynamicResource NewContact}"/>
        <Label Content="Search Contact:" Width="100" Margin="-550,10,125,5" FontWeight="ExtraBlack"/>
        <TextBox TextChanged="TextSearch_Value" Width="500" Margin="-40,-35,5,0" FontSize="20"/>


        <ListView x:Name="ContactDataView" Margin="5,6,5,5" SelectionChanged="Constact_Selecte" Background="Honeydew" Height="350">
            <!--<ListView.ItemTemplate>
                <DataTemplate> custom controller 
                    <uc:ContactControl Contact="{Binding}" />
                </DataTemplate>
            </ListView.ItemTemplate>-->
             <ListView.View>
                <GridView>
                    <!--  <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="50"/>-->
                    <GridViewColumn Header="First name" DisplayMemberBinding="{Binding First_Name}" Width="200"/>
                    <GridViewColumn Header="Last name" DisplayMemberBinding="{Binding Last_Name}" Width="200"/>
                    <GridViewColumn Header="Gmail" DisplayMemberBinding="{Binding Email}" Width="310"/>
                    <GridViewColumn Header="Phone number" DisplayMemberBinding="{Binding PhoneNumber}" Width="250"/>
                </GridView>
            </ListView.View>
        </ListView>
    </StackPanel>
</Window>
